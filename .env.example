# IMPORTANTE (local): no pongas el .db dentro del repo.
# Ejemplo Windows (solo local, sin Turso):
# TURSO_DATABASE_URL=file:C:/Users/TU_USUARIO/AppData/Local/sorteillos/local.db

# Producción / Turso:
TURSO_DATABASE_URL=libsql://TU-DB.turso.io
TURSO_AUTH_TOKEN=

# URL pública de la app (opcional; útil para enlaces absolutos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
